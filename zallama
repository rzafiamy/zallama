def _bench_point_key(rec: dict) -> str:
    """The workload identity a point must share to be comparable across runs."""
    bits = [rec.get("model", "?")]
    params = " ".join(f"{k}={_bench_fmt_value(v)}"
                      for k, v in (rec.get("params") or {}).items())
    if params:
        bits.append(params)
    bits.append(f"prompt {rec.get('prompt_tokens_target')}")
    bits.append(f"gen {rec.get('max_tokens')}")
    if (rec.get("concurrency") or 1) > 1:
        bits.append(f"conc {rec['concurrency']}")
    return " · ".join(bits)


def cmd_bench_compare(paths: list[str], metrics: list[str]):
    """Put several bench exports side by side: zallama bench --compare a.json b.json

    The first file is the baseline; every other column shows its delta against
    it. Only points with identical model, params and workload are compared —
    anything unmatched is listed rather than silently dropped.
    """
    if len(paths) < 2:
        _err("--compare needs at least two .json exports.")
        _info("Produce them with: zallama bench <model> ... --out <machine>.json")
        sys.exit(1)

    runs: list[dict] = []
    for path in paths:
        file = Path(path).expanduser()
        if not file.is_file():
            _err(f"No such file: {path}"); sys.exit(1)
        try:
            data = json.loads(file.read_text())
        except ValueError as e:
            _err(f"{path} is not valid JSON ({e}).")
            _info("--compare reads .json exports only; .csv/.md drop the machine info.")
            sys.exit(1)
        results = data.get("results")
        if results is None:
            _err(f"{path} has no 'results' — is it a zallama bench export?")
            sys.exit(1)
        env = data.get("environment", {})
        runs.append({
            "label": data.get("label") or file.stem,
            "env": env,
            "points": {_bench_point_key(r): r
                       for r in results if r.get("decode_tps")},
        })

    print(f"\n{BOLD}{F_BLUE} Machines{RESET}")
    _print_table(
        ["LABEL", "GPU", "VRAM GiB", "DRIVER", "CPU", "POINTS"],
        [[run["label"],
          _bench_gpu_name(run["env"]),
          (f"{run['env']['gpus'][0]['vram_gib']:.1f}"
           if run["env"].get("gpus") else "—"),
          run["env"].get("driver") or "—",
          (run["env"].get("cpu") or "—")[:28],
          str(len(run["points"]))] for run in runs])

    builds = {b for run in runs for r in run["points"].values()
              if (b := r.get("engine_build"))}
    if len(builds) > 1:
        _info(f"llama.cpp builds differ across these exports ({', '.join(sorted(builds))}) "
              f"— part of any gap below may be the engine, not the hardware.")

    baseline = runs[0]
    shared = [k for k in baseline["points"]
              if all(k in run["points"] for run in runs[1:])]
    if not shared:
        _err("No workload point is present in every export.")
        _info("Points only compare when model, swept params, prompt size, "
              "max-tokens and concurrency all match.")
        return

    for metric in metrics:
        title, better, fmt = _BENCH_METRICS[metric]
        if not any(run["points"][k].get(metric) is not None
                   for k in shared for run in runs):
            continue
        headers = ["POINT", f"{runs[0]['label']} (base)"]
        aligns = ["left", "right"]
        for run in runs[1:]:
            headers.append(run["label"]); aligns.append("right")

        rows = []
        for key in shared:
            base_val = baseline["points"][key].get(metric)
            row = [key, fmt.format(base_val) if base_val is not None else "—"]
            for run in runs[1:]:
                val = run["points"][key].get(metric)
                if val is None or not base_val:
                    row.append("—")
                    continue
                pct = (val - base_val) / base_val * 100
                gain = pct > 0 if better == "higher" else pct < 0
                color = F_TEAL if gain else F_RED
                if abs(pct) < 1:
                    color = F_GRAY
                row.append(f"{fmt.format(val)} "
                           f"{_color(f'({pct:+.0f}%)', color)}")
            rows.append(row)

        print(f"\n{BOLD}{F_BLUE} {title}{RESET}"
              f"{F_DIM}  ({better} is better, % vs {runs[0]['label']}){RESET}")
        _print_table(headers, rows, aligns)

    for run in runs:
        missing = [k for k in run["points"] if k not in shared]
        if missing:
            print(f"\n{F_DIM}  {run['label']}: {len(missing)} point(s) with no "
                  f"counterpart elsewhere — not compared.{RESET}")
    print()


_BENCH_USAGE = f"""{BOLD}Usage:{RESET} zallama bench <model> [<model> ...] [options]

Measures tokens/sec for text models, optionally sweeping llama-server
parameters. Each combination is applied to the registry, the model is restarted
so it takes effect, and the original parameters are restored at the end.

{BOLD}Sweeps{RESET}
  --sweep <key>=<v1>,<v2>   Sweep any registry param; repeat for a grid.
                            e.g. ctx_size, reasoning, n_gpu_layers, threads,
                            batch_size, ubatch_size, flash_attn, parallel,
                            cache_type_k, cache_type_v, spec_type

{BOLD}Workload{RESET}
  -p, --prompt-tokens N[,N] Prompt sizes to send      (default 512)
  -n, --max-tokens N        Tokens to generate        (default 128)
  -c, --concurrency N[,N]   Simultaneous requests     (default 1)
  -r, --runs N              Measured runs per point   (default 3)
      --warmup N            Discarded runs per point  (default 1)
      --temp F              Sampling temperature      (default 0.0)
      --natural             Let the model stop on its own (default: generate
                            exactly --max-tokens via ignore_eos)
      --reuse-cache         Don't defeat the prompt cache — measures the warm
                            prefill path instead of a cold one

{BOLD}Selection & output{RESET}
      --all                 Bench every registered text model
  -o, --out FILE            Write results (.json / .csv / .md)
      --label NAME          Name this machine in the export (default: its GPU)
      --keep                Leave the last swept params in the registry
      --dry-run             Print the matrix and exit
      --timeout S           Per-request timeout       (default 600)

{BOLD}Examples{RESET}
  zallama bench Qwen3.5-4B-Q6_K
  zallama bench Qwen3.5-4B-Q6_K --sweep ctx_size=4096,16384,65536
  zallama bench Qwen3.5-4B-Q6_K --sweep reasoning=on,off -p 512,8192
  zallama bench Qwen3.5-4B-Q6_K --sweep n_gpu_layers=0,20,99 -o bench.md
  zallama bench --all -c 1,4 --runs 5 -o results.json

{BOLD}Comparing machines{RESET}
  zallama bench --compare a.json b.json [...] [--metric decode_tps,ttft_ms]

  Run the same command on each machine, exporting to .json, then compare. Only
  points with identical model, params and workload are put side by side; the
  first file is the baseline. Metrics: {", ".join(_BENCH_METRICS)}.

  # on each box
  zallama bench my-model --sweep ctx_size=32768 --sweep reasoning=on,off \\
      -p 32000 -n 256 --out $(hostname).json
  zallama bench --compare rtx4090.json rtx3090.json
"""


def cmd_bench(args: list[str]):
    """Benchmark tokens/sec across parameter sweeps: zallama bench <model> ..."""
    if not args or args[0] in ("-h", "--help"):
        print(_BENCH_USAGE)
        sys.exit(0 if args else 1)

    models: list[str] = []
    sweeps: list[tuple[str, list]] = []
    prompt_sizes = [512]
    concurrencies = [1]
    max_tokens, runs, warmup = 128, 3, 1
    temp, timeout = 0.0, 600.0
    out_path: str | None = None
    label: str | None = None
    metrics = ["prefill_tps", "decode_tps", "ttft_ms"]
    compare = False
    keep = natural = reuse_cache = dry_run = bench_all = False

    i = 0
    while i < len(args):
        arg = args[i]
        val = args[i + 1] if i + 1 < len(args) else None
        if arg in ("--sweep", "-s"):
            if not val or "=" not in val:
                _err("--sweep expects <param>=<v1>,<v2>[,...]")
                sys.exit(1)
            key, raw = val.split("=", 1)
            values = [_parse_param_value(v.strip()) for v in raw.split(",") if v.strip()]
            if not values:
                _err(f"--sweep {key} has no values")
                sys.exit(1)
            sweeps.append((key.strip(), values))
            i += 2
        elif arg in ("--prompt-tokens", "-p"):
            prompt_sizes = _bench_int_list(arg, val); i += 2
        elif arg in ("--concurrency", "-c"):
            concurrencies = _bench_int_list(arg, val); i += 2
        elif arg in ("--max-tokens", "-n"):
            max_tokens = _bench_int_list(arg, val)[0]; i += 2
        elif arg in ("--runs", "-r"):
            runs = _bench_int_list(arg, val)[0]; i += 2
        elif arg == "--warmup":
            if val is None:
                _err("--warmup expects a value"); sys.exit(1)
            warmup = max(0, int(val)); i += 2
        elif arg == "--temp":
            if val is None:
                _err("--temp expects a value"); sys.exit(1)
            temp = float(val); i += 2
        elif arg == "--timeout":
            if val is None:
                _err("--timeout expects a value"); sys.exit(1)
            timeout = float(val); i += 2
        elif arg in ("--out", "-o"):
            if val is None:
                _err("--out expects a file path"); sys.exit(1)
            out_path = val; i += 2
        elif arg == "--label":
            if val is None:
                _err("--label expects a name"); sys.exit(1)
            label = val; i += 2
        elif arg == "--metric":
            if val is None:
                _err("--metric expects a name"); sys.exit(1)
            metrics = [m.strip() for m in val.split(",") if m.strip()]
            unknown = [m for m in metrics if m not in _BENCH_METRICS]
            if unknown:
                _err(f"Unknown metric(s): {', '.join(unknown)}")
                _info(f"Available: {', '.join(_BENCH_METRICS)}")
                sys.exit(1)
            i += 2
        elif arg == "--compare":
            compare = True; i += 1
        elif arg == "--natural":
            natural = True; i += 1
        elif arg == "--reuse-cache":
            reuse_cache = True; i += 1
        elif arg == "--keep":
            keep = True; i += 1
        elif arg == "--dry-run":
            dry_run = True; i += 1
        elif arg == "--all":
            bench_all = True; i += 1
        elif arg.startswith("-"):
            _err(f"Unknown option: {arg}")
            _info("Run 'zallama bench --help' for usage.")
            sys.exit(1)
        else:
            models.append(arg); i += 1

    if compare:
        # Reading exports needs no daemon, no model and no registry writes.
        cmd_bench_compare(models, metrics)
        return

    if not models and not bench_all:
        _err("Name at least one model, or pass --all.")
        sys.exit(1)

    r = _api("GET", "/api/models")
    if r.status_code != 200:
        _err(f"Failed to fetch models: {r.text}")
        sys.exit(1)
    catalog = r.json().get("models", [])

    targets: list[dict] = []
    if bench_all:
        targets = [m for m in catalog
                   if m.get("modality", "text") == "text" and m.get("file_ok")]
        if not targets:
            _err("No registered text models with a readable file.")
            sys.exit(1)
    for name in models:
        entry = next((m for m in catalog
                      if m["name"] == name or name in m.get("aliases", [])), None)
        if not entry:
            _err(f"Model '{name}' not found in registry.")
            sys.exit(1)
        if entry.get("modality", "text") != "text":
            _err(f"'{name}' has modality '{entry.get('modality')}'; bench measures "
                 f"text generation only.")
            sys.exit(1)
        if not entry.get("file_ok"):
            _err(f"Model file is missing: {entry.get('file')}")
            sys.exit(1)
        if not any(t["name"] == entry["name"] for t in targets):
            targets.append(entry)

    sweep_keys = [k for k, _ in sweeps]
    combos = list(product(*[v for _, v in sweeps])) if sweeps else [()]
    workloads = list(product(prompt_sizes, concurrencies))
    total_points = len(targets) * len(combos) * len(workloads)
    total_reqs = total_points * (runs + warmup) * max(concurrencies)

    env = _bench_environment()
    label = label or _bench_default_label(env)
    print(f"\n{BOLD}{F_BLUE} Benchmark plan{RESET}")
    plan = [
        ["Machine", f"{label}  ({_bench_gpu_name(env)})"],
        ["Models", ", ".join(t["name"] for t in targets)],
        ["Restarts (param combos)", f"{len(targets) * len(combos)}"],
        ["Measured points", f"{total_points}"],
        ["Requests (incl. warmup)", f"~{total_reqs}"],
        ["Prompt sizes", ", ".join(str(p) for p in prompt_sizes)],
        ["Generate", f"{max_tokens} tokens"
                     f"{' (natural stop)' if natural else ' (fixed, ignore_eos)'}"],
        ["Concurrency", ", ".join(str(c) for c in concurrencies)],
        ["Runs / warmup", f"{runs} / {warmup}"],
        ["Prompt cache", "reused" if reuse_cache else "defeated (cold prefill)"],
    ]
    for key, values in sweeps:
        plan.append([f"Sweep {key}", ", ".join(_bench_fmt_value(v) for v in values)])
    _print_table(["FIELD", "VALUE"], plan)

    if dry_run:
        print(f"\n{F_DIM}  Dry run — nothing was changed or measured.{RESET}\n")
        return

    if sweeps and not keep:
        print(f"\n{F_DIM}  Registry params are restored when the run ends "
              f"(including on Ctrl-C).{RESET}")
    print()

    records: list[dict] = []
    originals: dict[str, tuple[dict, dict]] = {}   # name -> (entry, params)
    ignore_eos = not natural

    try:
        for entry in targets:
            name = entry["name"]
            base_params = dict(entry.get("params", {}))
            originals[name] = (entry, base_params)

            for combo in combos:
                overrides = dict(zip(sweep_keys, combo))
                combo_label = " ".join(f"{k}={_bench_fmt_value(v)}"
                                       for k, v in overrides.items())

                if overrides:
                    params = dict(base_params)
                    for key, val in overrides.items():
                        if val is None:
                            params.pop(key, None)
                        else:
                            params[key] = val
                    if not _bench_set_params(entry, params):
                        _err(f"Could not apply {combo_label} to '{name}' — skipped.")
                        continue

                head = (f"{name}"
                        f"{('  ' + _color(combo_label, F_PURPLE)) if combo_label else ''}")
                print(f"  {_color('▸', F_BLUE)} {head}")
                print(f"    {_color('loading…', F_DIM)}", end="", flush=True)
                load_s, load_err = _bench_reload(name)
                if load_err:
                    print(f"\r    {_color('✗ ' + load_err, RED)}{' ' * 12}")
                    records.append({
                        "model": name, "params": overrides, "error": load_err,
                        "max_tokens": max_tokens, "runs": runs,
                    })
                    continue
                vram = _bench_vram(name)
                print(f"\r    {_color(f'loaded in {load_s:.1f}s', F_DIM)}"
                      f"{_color(f' · {vram:.1f} GiB VRAM', F_DIM) if vram else ''}"
                      f"{' ' * 12}")

                for ptokens, conc in workloads:
                    print(f"    {_color(f'prompt {ptokens} · conc {conc} …', F_DIM)}",
                          end="", flush=True)
                    for w in range(warmup):
                        _bench_batch(name, ptokens, max_tokens, temp, ignore_eos,
                                     timeout, conc, reuse_cache, f"warm{w}")

                    samples: list[dict] = []
                    batch_tps: list[float] = []
                    errors: list[str] = []
                    for run_idx in range(runs):
                        results, batch_wall = _bench_batch(
                            name, ptokens, max_tokens, temp, ignore_eos, timeout,
                            conc, reuse_cache, f"run{run_idx}")
                        ok = [x for x in results if "error" not in x]
                        errors += [x["error"] for x in results if "error" in x]
                        samples += ok
                        if ok and batch_wall > 0:
                            batch_tps.append(sum(x["gen_tokens"] for x in ok) / batch_wall)

                    if not samples:
                        msg = errors[0] if errors else "no successful runs"
                        print(f"\r    {_color('✗ ' + msg, RED)}{' ' * 20}")
                        records.append({
                            "model": name, "params": overrides, "error": msg,
                            "prompt_tokens_target": ptokens, "concurrency": conc,
                            "max_tokens": max_tokens, "runs": runs,
                            "load_s": round(load_s, 2), "vram_gib": vram,
                        })
                        continue

                    decodes = [s["decode_tps"] for s in samples if s["decode_tps"]]
                    record = {
                        "model": name,
                        "params": overrides,
                        "prompt_tokens_target": ptokens,
                        "prompt_tokens": samples[0]["prompt_tokens"],
                        "max_tokens": max_tokens,
                        "concurrency": conc,
                        "runs": runs,
                        "load_s": round(load_s, 2),
                        "vram_gib": round(vram, 2) if vram else None,
                        "ttft_ms": _bench_mean([s["ttft_ms"] for s in samples]),
                        "prefill_tps": _bench_mean([s["prefill_tps"] for s in samples]),
                        "decode_tps": _bench_mean(decodes),
                        "decode_tps_stdev": (round(statistics.stdev(decodes), 2)
                                             if len(decodes) > 1 else None),
                        "throughput_tps": _bench_mean(batch_tps),
                        "gen_tokens": samples[0]["gen_tokens"],
                        # Max, not first: a cache hit on any run is what explains
                        # a prefill rate that looks impossibly good.
                        "cached_tokens": max(s["cached_tokens"] for s in samples),
                        "engine_build": samples[0].get("engine_build"),
                        "error": "; ".join(dict.fromkeys(errors))[:160] or None,
                        # Kept out of the export schema: only the terminal table
                        # shows spread, and it needs the raw samples for that.
                        "_samples": samples,
                        "_batch_tps": batch_tps,
                    }
                    records.append(record)
                    decode = record["decode_tps"] or 0.0
                    print(f"\r    {_color(f'prompt {ptokens} · conc {conc}', F_DIM)}"
                          f"  {_color(f'{decode:.1f} tok/s', F_TEAL)}"
                          f"{_color(' decode', F_DIM)}{' ' * 12}")
                print()
    except KeyboardInterrupt:
        print(f"\n{_color('  Interrupted — restoring registry params…', YELLOW)}")
    finally:
        if keep:
            _info("--keep: the last swept params were left in the registry.")
        else:
            for name, (entry, params) in originals.items():
                _bench_set_params(entry, params)
                # The instance still runs with bench params; drop it so the next
                # load picks up what was just restored.
                _api("POST", f"/api/models/{name}/unload")

    measured = [r for r in records if r.get("decode_tps")]
    if not measured:
        _err("No successful measurements.")
        return

    _bench_report(measured, sweep_keys)

    if out_path:
        gpu = _bench_gpu_name(env)
        for rec in records:
            rec.pop("_samples", None)
            rec.pop("_batch_tps", None)
            rec["label"] = label
            rec["gpu"] = gpu
        _bench_export(out_path, records, label, env)
        _ok(f"Results written to {out_path}")


def _bench_mean(values: list) -> float | None:
    vals = [v for v in values if v is not None]
    return round(statistics.fmean(vals), 2) if vals else None


def _bench_report(records: list[dict], sweep_keys: list[str]):
    """Print the results table plus the fastest combination per model."""
    multi_model = len({r["model"] for r in records}) > 1
    has_vram = any(r.get("vram_gib") for r in records)
    show_conc = any(r["concurrency"] > 1 for r in records)

    headers, aligns = [], []
    if multi_model:
        headers.append("MODEL"); aligns.append("left")
    if sweep_keys:
        headers.append("PARAMS"); aligns.append("left")
    headers += ["PROMPT", "GEN"]; aligns += ["right", "right"]
    if show_conc:
        headers.append("CONC"); aligns.append("right")
    headers += ["LOAD s"]; aligns += ["right"]
    if has_vram:
        headers.append("VRAM GiB"); aligns.append("right")
    headers += ["TTFT ms", "PREFILL t/s", "DECODE t/s"]
    aligns += ["right", "right", "right"]
    if show_conc:
        headers.append("TOTAL t/s"); aligns.append("right")

    rows = []
    for rec in records:
        row = []
        if multi_model:
            row.append(rec["model"])
        if sweep_keys:
            row.append(_color(" ".join(f"{k}={_bench_fmt_value(v)}"
                                       for k, v in rec["params"].items()), F_PURPLE))
        row += [str(rec["prompt_tokens"]), str(rec["gen_tokens"])]
        if show_conc:
            row.append(str(rec["concurrency"]))
        row.append(f"{rec['load_s']:.1f}")
        if has_vram:
            row.append(f"{rec['vram_gib']:.1f}" if rec.get("vram_gib") else "—")
        row += [
            _bench_stat([s["ttft_ms"] for s in rec["_samples"]], "{:.0f}"),
            _bench_stat([s["prefill_tps"] for s in rec["_samples"]], "{:.0f}"),
            _color(_bench_stat([s["decode_tps"] for s in rec["_samples"]]), F_TEAL),
        ]
        if show_conc:
            row.append(_bench_stat(rec["_batch_tps"]))
        rows.append(row)

    print(f"\n{BOLD}{F_BLUE} Results{RESET}"
          f"{F_DIM}  (mean ± stdev across runs){RESET}")
    _print_table(headers, rows, aligns)
    notes = ["PREFILL = prompt processing, DECODE = generation — both off "
             "llama.cpp's own clock.",
             "TTFT is measured at this client, so it includes queueing and "
             "proxy overhead."]
    if any(r.get("cached_tokens") for r in records):
        notes.append("Some prompts hit llama-server's KV cache, so PREFILL there "
                     "measures cached reuse, not real prompt processing.")
    if show_conc:
        notes.append("TOTAL = every request's tokens over the batch's wall time "
                     "(prefill included).")
        notes.append("Concurrency above the model's `parallel` slots just "
                     "queues — sweep parallel to raise it.")
    print("\n" + "\n".join(f"{F_DIM}  {n}{RESET}" for n in notes))

    for model in dict.fromkeys(r["model"] for r in records):
        mine = [r for r in records if r["model"] == model]
        best = max(mine, key=lambda r: r["decode_tps"])
        if len(mine) < 2:
            continue
        label = " ".join(f"{k}={_bench_fmt_value(v)}" for k, v in best["params"].items())
        detail = f"{label}, " if label else ""
        where = detail + f"prompt {best['prompt_tokens']}"
        rate = f"{best['decode_tps']:.1f} tok/s"
        print(f"  {_color('★', F_ORANGE)} {BOLD}{model}{RESET} fastest at "
              f"{_color(where, F_PURPLE)} → {_color(rate, F_TEAL)} decode")
    print()


def cmd_show(args: list[str]):
    """Show a single model's full configuration: zallama show <model>

    `zallama list` is a summary table; this prints *everything* the registry
    holds for one model — resolved file path, every param (merged view of the
    effective launch params), aliases, artifacts, declared mem_gb, and live
    status — so there is no longer a setting you cannot see from the CLI.
    """
    if not args:
        _err("Usage: zallama show <model>")
        sys.exit(1)
    model_name = args[0]

    r = _api("GET", "/api/models")
    if r.status_code != 200:
        _err(f"Failed to fetch models: {r.text}"); sys.exit(1)
    entry = None
    for m in r.json().get("models", []):
        if m["name"] == model_name or model_name in m.get("aliases", []):
            entry = m
            break
    if not entry:
        _err(f"Model '{model_name}' not found in registry."); sys.exit(1)

    size = entry.get("file_size", 0)
    size_str = f"{size / 1e9:.2f} GB" if size else "?"
    status = _color("● RUNNING", F_TEAL) if entry.get("running") else _color("○ stopped", F_DIM)
    if entry.get("running") and entry.get("port"):
        status += _color(f"  (port {entry['port']})", F_DIM)

    print(f"\n{BOLD}{F_BLUE} Model: {entry['name']}{RESET}")
    rows = [
        ["Status", status],
