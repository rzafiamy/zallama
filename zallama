def _default_zallama_host() -> str:
    """Base URL the CLI talks to, derived from config.yaml's zallama.host/port.

    ZALLAMA_HOST (full URL, e.g. "http://host:port") still wins if set — it's
    the CLI's own override, distinct from the daemon's ZALLAMA_HOST/ZALLAMA_PORT
    env vars which only set host/port fields inside load_config().
    """
    env = os.environ.get("ZALLAMA_HOST")
    if env:
        return env
    try:
        root = Path(__file__).resolve().parent
        if str(root) not in sys.path:
            sys.path.insert(0, str(root))
        from server.config import load_config
        cfg = load_config()["zallama"]
        host = cfg["host"]
        # A wildcard bind address isn't a valid address to connect *to*.
        if host in ("0.0.0.0", "::"):
            host = "127.0.0.1"
        return f"http://{host}:{cfg['port']}"
    except Exception:
        return "http://localhost:11435"


