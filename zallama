def _flatten_cfg(cfg: dict, prefix: str = "") -> list[tuple[str, object]]:
    """Flatten a nested config dict into [(dotted.key, value), ...] in order.

    default_params is kept as a single node (rendered as a compact dict) rather
    than exploded, because those are per-model-overridable defaults, not
    top-level daemon settings.
    """
    out: list[tuple[str, object]] = []
    for key, val in cfg.items():
        dotted = f"{prefix}{key}"
        if isinstance(val, dict) and dotted != "llama_server.default_params":
            out.extend(_flatten_cfg(val, prefix=f"{dotted}."))
        else:
            out.append((dotted, val))
    return out


def _config_write_section_keys(path: Path, section: str, updates: dict[str, str]) -> None:
    """Set keys inside a top-level section (e.g. `zallama:`) of a config.yaml.

    Edits the file line-by-line so user comments and formatting are preserved
    (a YAML round-trip would drop them). Creates the file/section as needed.
    """
    import re

    lines = path.read_text().splitlines() if path.exists() else []

    start = next((i for i, l in enumerate(lines)
                  if re.match(rf"^{re.escape(section)}:\s*(#.*)?$", l)), None)
    if start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append(f"{section}:")
        start = len(lines) - 1
    end = next((i for i in range(start + 1, len(lines))
                if lines[i].strip() and not lines[i][0] in " \t#"), len(lines))

    for key, value in updates.items():
        if isinstance(value, bool):
            literal = "true" if value else "false"
        elif isinstance(value, str) and value.lower() in ("true", "false"):
            literal = value.lower()
        elif isinstance(value, str) and re.fullmatch(r"-?\d+", value):
            literal = value
        elif isinstance(value, (int, float)):
            literal = str(value)
        else:
            literal = f'"{value}"'
        rendered = f"  {key}: {literal}"
        pat = re.compile(rf"^(\s+){re.escape(key)}\s*:")
        idx = next((i for i in range(start + 1, end) if pat.match(lines[i])), None)
        if idx is not None:
            lines[idx] = rendered
        else:
            lines.insert(start + 1, rendered)
            end += 1

    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n")
    os.chmod(path, 0o600)


def _parse_expiry(spec: str) -> str:
    """Turn '30d' / '12h' / '2026-09-01' / 'never' into an ISO-8601 UTC instant ('' = never)."""
    import re
    from datetime import datetime, timedelta, timezone

    spec = spec.strip().lower()
    if spec in ("never", "none", "0"):
        return ""
    m = re.fullmatch(r"(\d+)([dhm])", spec)
    if m:
        n, unit = int(m.group(1)), m.group(2)
        delta = {"d": timedelta(days=n), "h": timedelta(hours=n), "m": timedelta(minutes=n)}[unit]
        return (datetime.now(timezone.utc) + delta).strftime("%Y-%m-%dT%H:%M:%SZ")
    try:
        return (datetime.strptime(spec, "%Y-%m-%d")
                .replace(tzinfo=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
    except ValueError:
        _err(f"Invalid --expires '{spec}'. Use e.g. 30d, 12h, 45m, 2026-09-01, or never.")
        sys.exit(1)


def cmd_apikey(args: list[str]):
    """Manage the daemon API key without ever storing it in plaintext.

    zallama apikey [--expires 30d]   Generate a key, store only its SHA-256 hash
    zallama apikey clear             Disable API-key auth
    zallama apikey hash <key>        Store the hash of a key you chose yourself

    --expires accepts 30d / 12h / 45m, an absolute date (2026-09-01), or
    'never'. Default: 30d. The daemon rejects the key after that instant.
    """
    import hashlib
    import secrets as _secrets

    root = Path(__file__).resolve().parent
    sys.path.insert(0, str(root))
    from server.config import _find_config_file

    config_file = _find_config_file() or (Path.home() / ".zallama" / "config.yaml")

    expires_spec = "30d"
    rest: list[str] = []
    it = iter(args)
    for a in it:
        if a == "--expires":
            expires_spec = next(it, "") or expires_spec
        elif a.startswith("--expires="):
            expires_spec = a.split("=", 1)[1]
        else:
            rest.append(a)
    action = rest[0] if rest else "rotate"

    if action == "clear":
        _config_write_section_keys(
            config_file, "zallama", {"api_key_sha256": "", "api_key": "", "api_key_expires": ""})
        _ok(f"API-key auth disabled in {config_file}")
    elif action in ("rotate", "hash"):
        if action == "hash":
            if len(rest) < 2 or not rest[1].strip():
                _err("Usage: zallama apikey hash <key> [--expires 30d]")
                sys.exit(1)
            key = rest[1].strip()
        else:
            key = _secrets.token_hex(32)
        expires = _parse_expiry(expires_spec)
        digest = hashlib.sha256(key.encode()).hexdigest()
        _config_write_section_keys(
            config_file, "zallama",
            {"api_key_sha256": digest, "api_key": "", "api_key_expires": expires})
        when = expires if expires else "never"
        _ok(f"API key hashed into {config_file} (expires: {when})")
        if action == "rotate":
            print(f"\n  {BOLD}{key}{RESET}\n")
            print(f"{F_DIM}  Save it now — it cannot be recovered from the config. "
                  f"Use it as: Authorization: Bearer <key>{RESET}")
    else:
        _err(f"Unknown action '{action}'. Use: zallama apikey [clear|hash <key>] [--expires 30d]")
        sys.exit(1)

    print(f"{F_DIM}  Restart the daemon to apply (config.yaml is read at startup).{RESET}")


def cmd_config(args: list[str]):
    """Show or edit the persisted configuration.

    zallama config                    Show the effective merged configuration
    zallama config set <key> <value>  Write a key (dotted path) into config.yaml

    Resolves config through the daemon's own load_config() (the single source of
    truth, same as `zallama paths`), so display shows exactly what the daemon
    uses — defaults merged with config.yaml and env overrides.
    """
    root = Path(__file__).resolve().parent
    sys.path.insert(0, str(root))
    try:
        from server.config import load_config, _find_config_file
        cfg = load_config()
        config_file = _find_config_file()
    except Exception as e:
        _err(f"Could not load configuration: {e}")
        sys.exit(1)

    if args and args[0] == "set":
        if len(args) != 3:
            _err("Usage: zallama config set <key> <value>  (e.g. zallama config set zallama.port 8080)")
            sys.exit(1)
        dotted, value = args[1], args[2]
        section, _, key = dotted.partition(".")
        if not key or section not in ("zallama", "llama_server", "rag") or key == "default_params":
            _err(f"Unknown or read-only key '{dotted}'. Run `zallama config` to list settable keys.")
            sys.exit(1)
        if dotted not in _CONFIG_KEY_HELP and section != "llama_server":
            _err(f"Unknown key '{dotted}'. Run `zallama config` to list settable keys.")
            sys.exit(1)
        target = config_file or (Path.home() / ".zallama" / "config.yaml")
        _config_write_section_keys(target, section, {key: value})
        _ok(f"Set {dotted} = {value} in {target}")
        print(f"{F_DIM}  Restart the daemon to apply (config.yaml is read at startup).{RESET}")
        return

    src = str(config_file) if config_file else "(none — using built-in defaults)"
    print(f"\n{BOLD}{F_BLUE} Effective Zallama Configuration{RESET}")
    print(f"{F_DIM}  Source: {src}{RESET}")

    rows = []
    for dotted, val in _flatten_cfg(cfg):
        if dotted == "llama_server.default_params" and isinstance(val, dict):
            shown = ", ".join(f"{k}={v}" for k, v in val.items())
        elif val == "" or val is None:
            shown = _color("(empty)", F_DIM)
        else:
            shown = str(val)
        desc = _CONFIG_KEY_HELP.get(dotted, "")
        rows.append([_color(dotted, F_TEAL), shown, _color(desc, F_DIM)])
    _print_table(["KEY", "VALUE", "DESCRIPTION"], rows)

    print(f"\n{F_DIM}  To change a value: edit {src if config_file else '~/.zallama/config.yaml'} "
          f"and restart the daemon.{RESET}")
    print(f"{F_DIM}  Per-model overrides of default_params: {RESET}{BOLD}zallama set <model> <key>=<value>{RESET}\n")


import threading

class Spinner:
    def __init__(self, message="Thinking..."):
        self.message = message
        self.running = False
        self.thread = None

    def _spin(self):
        chars = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
        idx = 0
        while self.running:
            sys.stdout.write(f"\r{_color(chars[idx], F_BLUE + BOLD)} {F_DIM}{self.message}{RESET}")
            sys.stdout.flush()
            idx = (idx + 1) % len(chars)
            time.sleep(0.08)
        sys.stdout.write("\r" + " " * (len(self.message) + 15) + "\r")
        sys.stdout.flush()

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._spin, daemon=True)
        self.thread.start()

    def stop(self):
        if self.running:
            self.running = False
            if self.thread:
                self.thread.join()

def cmd_run(args: list[str]):
    """Interactive chat: zallama run <model>"""
    if not args:
        _err("Usage: zallama run <model-name>")
        sys.exit(1)
    model = args[0]

    # Fetch model details to check modality
    r_models = _api("GET", "/api/models")
    if r_models.status_code == 200:
        models_info = r_models.json().get("models", [])
        model_entry = next((m for m in models_info if m["name"] == model), None)
        if model_entry and model_entry.get("modality") == "asr":
            _err(f"Model '{model}' is an ASR (Speech-to-Text) model and cannot be used in interactive chat.")
            _info("To transcribe audio with this model, use:")
            _info(f"  zallama transcribe {model} <audio-file.wav>")
            sys.exit(1)
        elif model_entry and model_entry.get("modality") == "image":
            _err(f"Model '{model}' is an Image Generation model and cannot be used in interactive chat.")
            _info("To generate images with this model, use:")
            _info(f"  zallama generate {model} \"<prompt>\"")
            sys.exit(1)

    # Width-aware Fluent 2 style banner header. The inner width adapts to the
    # terminal (capped) so a long model name never overflows or misaligns the box.
    inner = min(_term_width() - 4, 64)
    bar = "─" * inner

    def _banner_row(text: str, color: str) -> str:
        pad = " " * max(0, inner - _visible_len(text))
        return f"{_color('│', F_BLUE)} {color}{text}{pad}{RESET} {_color('│', F_BLUE)}"

    def _trunc(s: str) -> str:
        return s if len(s) <= inner else s[: inner - 1] + "…"

    print(_color(f"\n╭{bar}╮", F_BLUE))
    print(_banner_row("ZALLAMA INTERACTIVE CHAT", BOLD + F_WHITE))
    print(_banner_row(_trunc(f"Model: {model}"), F_GRAY))
    print(_banner_row(_trunc("Type a message and press Enter. /exit to quit, /clear to reset."), F_DIM))
    print(_color(f"╰{bar}╯", F_BLUE))

    # First, ensure the model is loaded (may take a moment)
    print(_color(f"⏳ Loading model '{model}'...", F_ORANGE), end="", flush=True)
    r = _api("POST", f"/api/models/{model}/load")
    if r.status_code != 200:
        print()
        _err(f"Failed to load model: {r.json().get('detail', r.text)}")
        sys.exit(1)
    print(_color(" Ready!", F_TEAL))

    history = []

    while True:
        try:
            user_input = input(_color("\nUser › ", F_BLUE + BOLD)).strip()
        except (KeyboardInterrupt, EOFError):
            print("\n" + _color("Goodbye! 👋", F_DIM))
            break

        if not user_input:
            continue
        if user_input.lower() in ("/exit", "/quit", "exit", "quit"):
            print(_color("Goodbye! 👋", F_DIM))
            break
        if user_input == "/clear":
            history = []
            print(_color("History cleared.", F_DIM))
            continue

        history.append({"role": "user", "content": user_input})

        payload = {"model": model, "messages": history, "stream": True}
        spinner = Spinner("Thinking...")
        spinner.start()

        # Stream reasoning live (it's transient "thinking"), but accumulate the
        # answer content and render it beautified once complete — markdown can't
        # be cleanly formatted token-by-token, so we draft, then re-render.
        beautify = sys.stdout.isatty()
        reasoning_text = ""
        content_text = ""
        try:
            r = requests.post(
                f"{ZALLAMA_HOST}/v1/chat/completions",
                json=payload,
                stream=True,
                timeout=None,
            )

            if r.status_code != 200:
                spinner.stop()
                try:
                    err_msg = r.json().get("detail", r.text)
                except Exception:
                    err_msg = r.text
                print(_color(f"\nError: {err_msg}", F_RED))
                continue

            buffer = b""
            spinner_stopped = False
            in_reasoning = False
            content_started = False

            done = False
            for chunk in r.iter_content(chunk_size=None):
                buffer += chunk
                while b"\n" in buffer:
                    line_bytes, buffer = buffer.split(b"\n", 1)
                    line_str = line_bytes.decode("utf-8", errors="ignore").strip()
                    if not line_str:
                        continue
                    text = line_str[6:] if line_str.startswith("data: ") else line_str

                    if text == "[DONE]":
                        done = True
                        break

                    try:
                        chunk_json = json.loads(text)
                        delta = chunk_json["choices"][0]["delta"]

                        reasoning_content = delta.get("reasoning_content", "")
                        delta_content = delta.get("content", "")

                        if reasoning_content:
                            if not spinner_stopped:
                                spinner.stop(); spinner_stopped = True
                            if not in_reasoning:
                                in_reasoning = True
                                print(f"\n{BOLD}{F_PURPLE}🧠 Thinking Process:{RESET}")
                            print(_color(reasoning_content, F_DIM), end="", flush=True)
                            reasoning_text += reasoning_content
                        elif delta_content:
                            # Keep the spinner spinning while drafting the answer
                            # so the user sees progress; the frame prints at the end.
                            if in_reasoning:
                                in_reasoning = False
                                print("\n")
                            if not content_started:
                                content_started = True
                                if not beautify and not spinner_stopped:
                                    spinner.stop(); spinner_stopped = True
                                if not beautify:
                                    print(f"\n{BOLD}{F_TEAL}🦙 Assistant:{RESET}")
                            content_text += delta_content
                            if not beautify:
                                print(delta_content, end="", flush=True)
                    except Exception:
                        pass
                if done:
                    break

            if not spinner_stopped:
                spinner.stop()

            if beautify and content_text:
                _print_framed(content_text, "🦙 Assistant", F_TEAL)
            elif not beautify:
                print()

        except Exception as e:
            spinner.stop()
            print(_color(f"\nError: {e}", F_RED))
        except KeyboardInterrupt:
            spinner.stop()
            print(_color("\n[interrupted]", F_DIM))

        print()
        full_response = reasoning_text + content_text
        if content_text:
            history.append({"role": "assistant", "content": content_text})


