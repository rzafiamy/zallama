# ---------------------------------------------------------------------------
# GGUF metadata reader (header-only; no deps)
# ---------------------------------------------------------------------------
def _read_gguf_metadata(path: Path) -> dict:
    """Parse the key/value metadata from a GGUF file header.

    Reads only the header (not the tensor data), so it is fast even on
    multi-GB files. Returns a flat {key: value} dict for the scalar string/int
    keys we need to size a KV-cache (block_count, attention.head_count[_kv],
    embedding_length, context_length). Supports GGUF v2/v3.
    """
    import struct

    # GGUF scalar type ids -> (struct format, size in bytes).
    _SCALAR = {
        0: ("B", 1), 1: ("b", 1), 2: ("H", 2), 3: ("h", 2),
        4: ("I", 4), 5: ("i", 4), 6: ("f", 4), 7: ("?", 1),
        10: ("Q", 8), 11: ("q", 8), 12: ("d", 8),
    }
    STRING, ARRAY = 8, 9

    with open(path, "rb") as f:
        magic = f.read(4)
        if magic != b"GGUF":
            raise ValueError(f"Not a GGUF file (bad magic): {path}")
        version = struct.unpack("<I", f.read(4))[0]
        # tensor_count (u64) then metadata_kv_count (u64) in v2/v3.
        _ = struct.unpack("<Q", f.read(8))[0]
        kv_count = struct.unpack("<Q", f.read(8))[0]

        def read_str() -> str:
            n = struct.unpack("<Q", f.read(8))[0]
            return f.read(n).decode("utf-8", "replace")

        def read_scalar(tid: int):
            fmt, size = _SCALAR[tid]
            return struct.unpack("<" + fmt, f.read(size))[0]

        def skip_value(tid: int):
            # Consume a value of the given type without keeping it (for arrays
            # and keys we don't care about), so the cursor stays aligned.
            if tid == STRING:
                read_str()
            elif tid == ARRAY:
                elem_tid = struct.unpack("<I", f.read(4))[0]
                count = struct.unpack("<Q", f.read(8))[0]
                for _ in range(count):
                    skip_value(elem_tid)
            else:
                read_scalar(tid)

        meta: dict = {}
        for _ in range(kv_count):
            key = read_str()
            tid = struct.unpack("<I", f.read(4))[0]
            if tid == STRING:
                meta[key] = read_str()
            elif tid == ARRAY:
                skip_value(ARRAY)  # arrays aren't needed for sizing
            else:
                meta[key] = read_scalar(tid)
        meta["_gguf_version"] = version
        return meta


def _gguf_arch_dims(meta: dict) -> dict | None:
    """Extract layer/head/embedding dims from GGUF metadata, arch-agnostic.

    Keys are namespaced by architecture (e.g. "llama.block_count"). We read the
    `general.architecture` value and look up that prefix. Returns None if the
    essential keys are missing (e.g. a non-text GGUF), letting the caller fall
    back to a size-based estimate.
    """
    arch = meta.get("general.architecture")
    if not arch:
        return None

    def g(suffix: str):
        return meta.get(f"{arch}.{suffix}")

    n_layer = g("block_count")
    n_embd = g("embedding_length")
    n_head = g("attention.head_count")
    # GQA: head_count_kv defaults to head_count when absent (full MHA).
    n_head_kv = g("attention.head_count_kv") or n_head
    train_ctx = g("context_length")
    if not (n_layer and n_embd and n_head and n_head_kv):
        return None
    head_dim = n_embd // n_head
    return {
        "arch": arch,
        "n_layer": int(n_layer),
        "n_embd": int(n_embd),
        "n_head": int(n_head),
        "n_head_kv": int(n_head_kv),
        "head_dim": int(head_dim),
        "train_ctx": int(train_ctx) if train_ctx else None,
    }


def _query_total_vram_gb() -> float | None:
    """Total VRAM (GB) of GPU 0 via nvidia-smi, or None if unavailable."""
    import shutil
    import subprocess

    if shutil.which("nvidia-smi") is None:
        return None
    try:
        out = subprocess.check_output(
            ["nvidia-smi", "--query-gpu=memory.total",
             "--format=csv,noheader,nounits"],
            text=True, timeout=5,
        )
    except Exception:
        return None
    first = out.strip().splitlines()
    if not first:
        return None
    try:
        return int(first[0].strip()) / 1024.0  # MiB -> GiB
    except ValueError:
        return None


def cmd_calibrate(args: list[str]):
    """Recommend max ctx_size + mem_gb for a model from your VRAM (dry-run).

    Usage: zallama calibrate <model>

    Queries total GPU VRAM, reads the model's GGUF architecture (layers, heads,
    GQA, head_dim), and computes the largest context window whose KV-cache still
    fits alongside the model weights and a compute reserve. Prints the
    recommendation and the exact `zallama set` command — it writes nothing.
    """
    if not args:
        _err("Usage: zallama calibrate <model>")
        _info("Recommends a max ctx_size + mem_gb from your VRAM. Changes nothing.")
        sys.exit(1)
    model_name = args[0]

    # 1. Locate the model entry (file path, size, current params).
    r = _api("GET", "/api/models")
    if r.status_code != 200:
        _err(f"Failed to fetch models: {r.text}"); sys.exit(1)
    entry = None
    for m in r.json().get("models", []):
        if m["name"] == model_name or model_name in m.get("aliases", []):
            entry = m
            break
    if not entry:
        _err(f"Model '{model_name}' not found in registry."); sys.exit(1)
    if entry.get("modality", "text") != "text":
        _err(f"Calibration targets text models; '{model_name}' is "
             f"'{entry.get('modality')}'. ctx_size sizing doesn't apply.")
        sys.exit(1)
    if not entry.get("file_ok"):
        _err(f"Model file is missing: {entry.get('file')}"); sys.exit(1)

    # 2. VRAM budget.
    total_vram = _query_total_vram_gb()
    if total_vram is None:
        _err("Could not query VRAM (no nvidia-smi or no NVIDIA GPU).")
        _info("Calibration currently supports NVIDIA GPUs only.")
        sys.exit(1)

    file_gb = entry.get("file_size", 0) / 1e9
    model_path = Path(entry["file"])

    # 3. GGUF architecture.
    try:
        meta = _read_gguf_metadata(model_path)
        dims = _gguf_arch_dims(meta)
    except Exception as e:
        dims = None
        _info(f"Could not read GGUF metadata ({e}); using a size-only estimate.")

    # 4. Budgeting. Leave a slice of VRAM for the OS/desktop + llama.cpp's
    #    compute buffers (activations, graph). 88% usable is a safe default on
    #    an 8GB laptop GPU where a few hundred MB are always taken by the DE.
    usable = total_vram * 0.88
    # Weights resident in VRAM ~= on-disk GGUF size (n_gpu_layers=99 => all on
    # GPU). A small compute reserve scales with model size.
    compute_reserve = max(0.4, file_gb * 0.10)
    kv_budget_gb = usable - file_gb - compute_reserve

    cur_ctx = entry.get("params", {}).get("ctx_size", 4096)

    if dims and kv_budget_gb > 0:
        # KV-cache bytes per token = 2 (K+V) * n_layer * n_head_kv * head_dim *
        # bytes_per_elem. llama.cpp defaults to f16 KV (2 bytes).
        bytes_per_tok = 2 * dims["n_layer"] * dims["n_head_kv"] * dims["head_dim"] * 2
        max_ctx = int((kv_budget_gb * 1e9) / bytes_per_tok)
        # Round down to a multiple of 1024 and clamp to the model's trained ctx.
        max_ctx = (max_ctx // 1024) * 1024
        if dims["train_ctx"]:
            max_ctx = min(max_ctx, dims["train_ctx"])
        max_ctx = max(max_ctx, 1024)
        kv_at_ctx = bytes_per_tok * max_ctx / 1e9
        est_mem_gb = round(file_gb + kv_at_ctx + compute_reserve, 1)
        method = "GGUF KV-cache model"
    else:
        # Fallback: no arch dims — recommend a conservative ctx and estimate
        # mem from file size only.
        max_ctx = 4096 if file_gb < usable * 0.6 else 2048
        est_mem_gb = round(file_gb * 1.2 + compute_reserve, 1)
        method = "size-only estimate (GGUF dims unavailable)"

    # 5. Report. Print only — never write.
    print(f"\n{BOLD}{F_BLUE} Calibration for '{model_name}'{RESET}")
    rows = [
        ["GPU VRAM (total)", f"{total_vram:.1f} GB"],
        ["Usable (88%)", f"{usable:.1f} GB"],
        ["Model weights (file)", f"{file_gb:.1f} GB"],
        ["Compute reserve", f"{compute_reserve:.1f} GB"],
        ["KV-cache budget", f"{max(kv_budget_gb, 0):.1f} GB"],
    ]
    if dims:
        rows.append(["Architecture",
                     f"{dims['arch']} • {dims['n_layer']}L • "
                     f"{dims['n_head_kv']} KV-heads • head_dim {dims['head_dim']}"])
        if dims["train_ctx"]:
            rows.append(["Trained ctx", f"{dims['train_ctx']}"])
    rows += [
        ["Current ctx_size", str(cur_ctx)],
        [_color("→ Recommended ctx_size", F_TEAL + BOLD),
         _color(str(max_ctx), F_TEAL + BOLD)],
        [_color("→ Recommended mem_gb", F_TEAL + BOLD),
         _color(str(est_mem_gb), F_TEAL + BOLD)],
    ]
    _print_table(["FIELD", "VALUE"], rows)
    print(f"\n{F_DIM}  Method: {method}. KV-cache assumes f16 ("
          f"halve mem with a quantized KV cache).{RESET}")

    if kv_budget_gb <= 0:
        _err(f"Weights ({file_gb:.1f} GB) + reserve exceed usable VRAM "
             f"({usable:.1f} GB). This model may not fit fully on GPU; "
             f"lower n_gpu_layers or use a smaller quant.")

    print(f"\n{BOLD}  To apply (dry-run only — nothing was changed):{RESET}")
    print(f"    {_color(f'zallama set {model_name} ctx_size={max_ctx} mem_gb={est_mem_gb}', CYAN)}")
    print(f"\n{F_DIM}  Then `zallama reload {model_name}` (or it applies on next load).{RESET}\n")


# ---------------------------------------------------------------------------
# bench — tokens/sec across parameter sweeps
# ---------------------------------------------------------------------------

# Prompts are padded to a target size with real prose. One word repeated N times
# tokenizes 3-4x denser than natural text, so "2048 tokens of context" built
# that way would not resemble the workload anyone actually runs.
_BENCH_FILLER = (
    "The harbour master kept a careful ledger of every vessel that entered the "
    "bay, noting its tonnage, its flag, the cargo in its hold and the weather it "
    "had sailed through to arrive. Over thirty winters that ledger became the "
    "only continuous record of trade along the coast, and captains who had lost "
    "their own papers would come ashore to copy their history back out of it. "
)


def _bench_prompt(target_tokens: int, nonce: str) -> str:
    """Build a prompt of roughly `target_tokens` tokens, prefixed with `nonce`.

    English GGUF tokenizers sit near 0.75 words per token, which is close
    enough — every reported prompt size is the exact `prompt_n` llama.cpp
    counted, never this estimate. The nonce leads on purpose: llama-server
    reuses the KV cache of a shared prefix, so a run-unique first token is what
    forces the full prefill we are here to measure.
    """
    words = _BENCH_FILLER.split()
    wanted = max(1, int(target_tokens * 0.75))
    padding: list[str] = []
    while len(padding) < wanted:
        padding.extend(words)
    return f"{nonce}{' '.join(padding[:wanted])}\n\nContinue the passage above."


def _bench_request(model: str, prompt: str, max_tokens: int, temp: float,
                   ignore_eos: bool, timeout: float) -> dict:
    """Run one streamed chat completion; return its metrics or {'error': ...}.

    Streaming is what makes time-to-first-token observable, and llama.cpp puts
    its own `timings` block in the final SSE chunk — so a single streamed call
    yields client-side latency *and* server-side prefill/decode rates.
    """
    body = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": max_tokens,
        "temperature": temp,
        "stream": True,
        "stream_options": {"include_usage": True},
    }
    if ignore_eos:
        # Pinning generation to exactly max_tokens means decode rates compare
        # identical amounts of work, instead of whatever length each parameter
        # combination happened to stop at.
        body["ignore_eos"] = True

    url = f"{ZALLAMA_HOST}/v1/chat/completions"
    t0 = time.perf_counter()
    ttft_ms = None
    timings: dict = {}
    usage: dict = {}
    build = None
    try:
        with requests.post(url, json=body, stream=True, timeout=timeout) as r:
            if r.status_code != 200:
                return {"error": f"HTTP {r.status_code}: {r.text[:160]}"}
            for line in r.iter_lines(decode_unicode=True):
                if not line or not line.startswith("data: "):
                    continue
                payload = line[6:].strip()
                if payload == "[DONE]":
                    break
                try:
                    obj = json.loads(payload)
                except ValueError:
                    continue
                if ttft_ms is None:
                    for choice in obj.get("choices") or []:
                        delta = choice.get("delta") or {}
                        # Thinking models emit reasoning_content first; that is
                        # still the model's first token.
                        if delta.get("content") or delta.get("reasoning_content"):
                            ttft_ms = (time.perf_counter() - t0) * 1000
                            break
                if obj.get("timings"):
                    timings = obj["timings"]
                if obj.get("usage"):
                    usage = obj["usage"]
                if build is None:
                    build = obj.get("system_fingerprint")
    except requests.exceptions.RequestException as e:
        return {"error": str(e)[:160]}

    wall = time.perf_counter() - t0
    gen = timings.get("predicted_n") or usage.get("completion_tokens") or 0
    return {
        "wall_s": wall,
        "ttft_ms": ttft_ms,
        # llama.cpp stamps its own build into every response; two exports built
        # by different llama.cpp versions are not comparable and this is what
        # makes that visible.
        "engine_build": build,
        "prompt_tokens": timings.get("prompt_n") or usage.get("prompt_tokens") or 0,
        "gen_tokens": gen,
        "cached_tokens": timings.get("cache_n", 0),
        # prefill/decode come off llama.cpp's own clock, so they exclude the HTTP
        # and proxy overhead that e2e_tps below deliberately includes.
        "prefill_tps": timings.get("prompt_per_second"),
        "decode_tps": timings.get("predicted_per_second"),
        "e2e_tps": (gen / wall) if wall > 0 else None,
    }


def _bench_batch(model: str, target_tokens: int, max_tokens: int, temp: float,
                 ignore_eos: bool, timeout: float, concurrency: int,
                 reuse_cache: bool, tag: str) -> tuple[list[dict], float]:
    """Fire `concurrency` requests at once; return their results + batch wall."""
    from concurrent.futures import ThreadPoolExecutor

    prompts = [
        _bench_prompt(target_tokens,
                      "" if reuse_cache else f"[{tag}/{i} {time.time_ns():x}] ")
        for i in range(concurrency)
    ]

    def run(p: str) -> dict:
        return _bench_request(model, p, max_tokens, temp, ignore_eos, timeout)

    t0 = time.perf_counter()
    if concurrency == 1:
        results = [run(prompts[0])]
    else:
        with ThreadPoolExecutor(max_workers=concurrency) as pool:
            results = list(pool.map(run, prompts))
    return results, time.perf_counter() - t0


def _bench_set_params(entry: dict, params: dict) -> bool:
    """Rewrite one model's `params`, leaving every other registry field intact."""
    payload = {
        "name": entry["name"],
        "file": entry["file"],
        "description": entry.get("description", ""),
        "aliases": entry.get("aliases", []),
        "params": params,
        "modality": entry.get("modality", "text"),
        "backend": entry.get("backend", "llama-server"),
        "artifacts": entry.get("artifacts", {}),
        "mem_gb": entry.get("mem_gb", 0),
        "pinned": entry.get("pinned", False),
    }
    return _api("POST", "/api/models/add", payload).status_code == 200


def _bench_reload(name: str) -> tuple[float | None, str | None]:
    """Unload then load `name`; return (load seconds, error message).

    Always unloading first is what makes a sweep honest: `load` on a running
    model returns the existing instance, which would still be serving the
    previous combination's parameters.
    """
    _api("POST", f"/api/models/{name}/unload")
    t0 = time.perf_counter()
    r = _api("POST", f"/api/models/{name}/load")
    load_s = time.perf_counter() - t0
    if r.status_code != 200:
        try:
            detail = r.json().get("detail", r.text)
        except ValueError:
            detail = r.text
        return None, str(detail)[:160]
    return load_s, None


def _bench_vram(name: str) -> float | None:
    """VRAM held by the running instance, when the GPU can be queried."""
    r = _api("GET", "/api/ps")
    if r.status_code != 200:
        return None
    for proc in r.json().get("processes", []):
        if proc.get("name") == name:
            return proc.get("vram_gb")
    return None


def _bench_fmt_value(val) -> str:
    return "true" if val is True else "false" if val is False else str(val)


def _bench_stat(values: list, fmt: str = "{:.1f}") -> str:
    """Mean of the samples, with the standard deviation when there are several."""
    vals = [v for v in values if v is not None]
    if not vals:
        return _color("—", F_DIM)
    mean = statistics.fmean(vals)
    if len(vals) < 2:
        return fmt.format(mean)
    return f"{fmt.format(mean)}{_color(' ±' + fmt.format(statistics.stdev(vals)), F_DIM)}"


def _bench_int_list(flag: str, raw: str | None) -> list[int]:
    """Parse a `--flag 512,2048` comma list of positive integers."""
    if not raw:
        _err(f"{flag} expects a value (e.g. {flag} 512,2048)")
        sys.exit(1)
    try:
        vals = [int(v.strip()) for v in raw.split(",") if v.strip()]
    except ValueError:
        _err(f"{flag} expects integers, got '{raw}'")
        sys.exit(1)
    if not vals or any(v <= 0 for v in vals):
        _err(f"{flag} expects positive integers, got '{raw}'")
        sys.exit(1)
    return vals


