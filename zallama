        _info("Example: zallama generate sd:1.5 \"a majestic mountain landscape at sunset\" --output mountain.png")
        sys.exit(1)

    model = args[0]
    prompt = args[1]

    output_path = "output.png"
    size = "512x512"
    # Left as None unless the user passes a flag: the daemon fills unset knobs
    # from the model's registry `params`, and sending a CLI default here would
    # silently override that per-model configuration.
    steps = None
    cfg_scale = None
    negative_prompt = ""

    i = 2
    while i < len(args):
        if args[i] == "--output" and i + 1 < len(args):
            output_path = args[i+1]
            i += 2
        elif args[i] == "--size" and i + 1 < len(args):
            size = args[i+1]
            i += 2
        elif args[i] == "--steps" and i + 1 < len(args):
            try:
                steps = int(args[i+1])
            except ValueError:
                pass
            i += 2
        elif args[i] == "--cfg-scale" and i + 1 < len(args):
            try:
                cfg_scale = float(args[i+1])
            except ValueError:
                pass
            i += 2
        elif args[i] == "--negative-prompt" and i + 1 < len(args):
            negative_prompt = args[i+1]
            i += 2
        else:
            i += 1

    payload = {
        "model": model,
        "prompt": prompt,
        "n": 1,
        "size": size,
        "response_format": "b64_json",
    }
    if steps is not None:
        payload["steps"] = steps
    if cfg_scale is not None:
        payload["cfg_scale"] = cfg_scale
    if negative_prompt:
        payload["negative_prompt"] = negative_prompt

    print(_color(f"🎨 Generating image with '{model}'...", F_ORANGE), end="", flush=True)
    r = _api("POST", "/v1/images/generations", payload)
    if r.status_code != 200:
        print()
        try:
            detail = r.json().get("detail", r.text)
        except Exception:
            detail = r.text
        _err(f"Generation failed: {detail}")
        sys.exit(1)

    data = r.json()
    items = data.get("data", [])
    if not items:
        print()
        _err("No image data returned from server.")
        sys.exit(1)

    item = items[0]
    import base64
    if "b64_json" in item:
        img_bytes = base64.b64decode(item["b64_json"])
        out_p = Path(output_path).expanduser().resolve()
        out_p.parent.mkdir(parents=True, exist_ok=True)
        out_p.write_bytes(img_bytes)
        print(_color(" Done!", F_TEAL))
        _ok(f"Saved generated image to {out_p}")
    elif "url" in item:
        print(_color(" Done!", F_TEAL))
        _ok(f"Image URL: {item['url']}")
    else:
        print(_color(" Done!", F_TEAL))
        _info(f"Response: {data}")



