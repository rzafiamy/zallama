    "label", "gpu", "model", "params", "prompt_tokens_target", "prompt_tokens",
    "max_tokens", "concurrency", "runs", "load_s", "vram_gib", "ttft_ms",
    "prefill_tps", "decode_tps", "decode_tps_stdev", "throughput_tps",
    "gen_tokens", "cached_tokens", "engine_build", "error",
]


def _bench_environment() -> dict:
    """Identify the machine, so two exports can be compared honestly.

    A tokens/sec number means nothing without the GPU, the driver and the
    llama.cpp build that produced it — `bench --compare` refuses to pretend
    otherwise, and this is what it reads.
    """
    import platform
    import shutil
    import subprocess

    env: dict = {
        "host": platform.node(),
        "platform": platform.platform(),
        "zallama_version": VERSION,
        "cpu": None,
        "gpus": [],
        "driver": None,
    }
    try:
        with open("/proc/cpuinfo") as fh:
            for line in fh:
                if line.startswith("model name"):
                    env["cpu"] = line.split(":", 1)[1].strip()
                    break
    except OSError:
        pass

    if shutil.which("nvidia-smi"):
        try:
            out = subprocess.check_output(
                ["nvidia-smi", "--query-gpu=name,memory.total,driver_version",
                 "--format=csv,noheader,nounits"],
                text=True, timeout=5)
            for line in out.strip().splitlines():
                parts = [p.strip() for p in line.split(",")]
                if len(parts) == 3:
                    env["gpus"].append({
                        "name": parts[0],
                        # nvidia-smi reports MiB; VRAM is a GiB quantity and
                        # calling it GB is how 24 GiB cards get mistaken for 24 GB.
                        "vram_gib": round(float(parts[1]) / 1024, 1),
                    })
                    env["driver"] = parts[2]
        except Exception:
            pass
    return env


def _bench_gpu_name(env: dict) -> str:
    gpus = env.get("gpus") or []
    return gpus[0]["name"] if gpus else "CPU"


def _bench_default_label(env: dict) -> str:
    """A short name for this machine — the GPU is what people actually compare."""
    if env.get("gpus"):
        name = _bench_gpu_name(env)
        return name.replace("NVIDIA ", "").replace("GeForce ", "").replace(" ", "-")
    return env.get("host") or "local"


def _bench_export(path: str, records: list[dict], label: str, env: dict) -> None:
    """Write results to .json, .csv or .md — the extension picks the format."""
    import csv

    out = Path(path).expanduser()
    out.parent.mkdir(parents=True, exist_ok=True)
    suffix = out.suffix.lower()

    if suffix == ".json":
        out.write_text(json.dumps(
            {"generated_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
             "zallama_version": VERSION,
             "label": label,
             "environment": env,
             "results": records},
            indent=2))
        return

    def flat(rec: dict) -> dict:
        row = {k: rec.get(k) for k in _BENCH_FIELDS}
        row["params"] = " ".join(
            f"{k}={_bench_fmt_value(v)}" for k, v in (rec.get("params") or {}).items())
        return row

    if suffix == ".csv":
        with out.open("w", newline="") as fh:
            writer = csv.DictWriter(fh, fieldnames=_BENCH_FIELDS)
            writer.writeheader()
            for rec in records:
                writer.writerow(flat(rec))
        return

    # Markdown (the default for any other extension) — pasteable into an issue.
    def cell(v) -> str:
        if v is None:
            return ""
        return f"{v:.1f}" if isinstance(v, float) else str(v)

    lines = [
        f"# zallama bench — {time.strftime('%Y-%m-%d %H:%M')}",
        "",
        "| " + " | ".join(_BENCH_FIELDS) + " |",
        "|" + "|".join("---" for _ in _BENCH_FIELDS) + "|",
    ]
    lines += ["| " + " | ".join(cell(flat(r)[f]) for f in _BENCH_FIELDS) + " |"
              for r in records]
    out.write_text("\n".join(lines) + "\n")


